####
# This Dockerfile is used by Quarkus `image-build` / container-image-docker.
# Build the app first (or let the Maven plugin do it), then the image copies
# from target/quarkus-app. Build context is filtered by .dockerignore.
#
# ./mvnw package
# ./mvnw quarkus:image-build
###
FROM ubuntu:24.04

ENV LANGUAGE='en_US:en'

ARG JDK_URL=https://download.oracle.com/java/27/latest/jdk-27_linux-x64_bin.tar.gz
ENV JAVA_HOME=/opt/java
ENV PATH="${JAVA_HOME}/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && curl -fsSL "${JDK_URL}" -o /tmp/jdk.tar.gz \
    && mkdir -p "${JAVA_HOME}" \
    && tar -xzf /tmp/jdk.tar.gz -C "${JAVA_HOME}" --strip-components=1 \
    && rm -rf /tmp/jdk.tar.gz \
    && apt-get purge -y curl \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 185 appuser && useradd -u 185 -g appuser -m appuser

# We make four distinct layers so if there are application changes the library layers can be re-used
COPY --chown=185 target/quarkus-app/lib/ /deployments/lib/
COPY --chown=185 target/quarkus-app/*.jar /deployments/
COPY --chown=185 target/quarkus-app/app/ /deployments/app/
COPY --chown=185 target/quarkus-app/quarkus/ /deployments/quarkus/

EXPOSE 8080
USER 185
ENV JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager -XX:+UseG1GC -Xms1g -Xmx4g"
ENV JAVA_APP_JAR="/deployments/quarkus-run.jar"

ENTRYPOINT [ "sh", "-c", "java $JAVA_OPTS_APPEND -jar $JAVA_APP_JAR" ]
