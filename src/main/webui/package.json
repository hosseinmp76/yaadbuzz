{
  "name": "yaadbuzz-webui",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "npm run typecheck && eslint .",
    "lint:fix": "eslint . --fix",
    "graphql:schema": "node scripts/fetch-graphql-schema.mjs",
    "graphql:codegen": "graphql-codegen --config codegen.ts",
    "graphql:generate": "npm run graphql:schema && npm run graphql:codegen"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/react": "^10.68.0",
    "@urql/core": "^5.1.1",
    "clsx": "^2.1.1",
    "graphql": "^16.11.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "motion": "^12.42.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.82.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.6.2",
    "sonner": "^2.0.7",
    "urql": "^4.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/typed-document-node": "^7.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^6.3.5"
  }
}
