# Keep context lean for:
# - Quarkus JVM image-build (Dockerfile.jvm → needs target/quarkus-app)
# - Quarkus native image-build (Dockerfile.native → target/*-runner)
# - docker compose multi-stage (Dockerfile.compose → pom.xml + src; builds inside)
.git
.idea
.cursor
.quinoa
**/node_modules
src/main/webui/node_modules
src/main/webui/dist
*.iml
*.log
agent-transcripts
.env
.new-env

# Exclude Maven output, but keep the fast-jar layout for Dockerfile.jvm
target/*
!target/quarkus-app
!target/quarkus-app/**
!target/*-runner
!target/*-runner.jar
